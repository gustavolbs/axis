{
  "name": "local-coder-mcp",
  "version": "0.14.0",
  "private": true,
  "description": "Provider-agnostic software engineering agent with Claude/MCP and standalone macOS interfaces.",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run dashboard:build && npm run console:build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dev:worker": "tsx src/worker-server.ts",
    "start:worker": "node dist/worker-server.js",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "dashboard": "npm run dashboard:build && node scripts/dashboard.mjs",
    "console:build": "vite build --config console/vite.config.ts",
    "console:start": "node dist/standalone-console.js",
    "console": "npm run build && npm run console:start",
    "desktop": "npm run build && electron .",
    "desktop:dir:mac": "npm run build && electron-builder --mac dir --publish never",
    "desktop:pack:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "desktop:release:mac": "node scripts/release-macos.mjs",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run build && npm test",
    "smoke:cloud": "npm run build && node scripts/smoke-cloud-providers.mjs",
    "install:claude": "node scripts/install-claude-user.mjs",
    "install:claude:windows": "node scripts/install-claude-windows-remote.mjs",
    "install:claude:worker": "node scripts/install-claude-remote-worker.mjs",
    "install:routing": "node scripts/install-claude-routing-rule.mjs",
    "install:claude-token-saver": "node scripts/install-claude-token-saver.mjs",
    "benchmark": "npm run build && node scripts/benchmark-local.mjs",
    "eval:agent": "npm run build && node scripts/eval-local-agent.mjs",
    "eval:providers": "npm run build && node scripts/eval-multi-provider.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "44.1.0",
    "electron-builder": "26.15.7",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.1.3"
  }
}
