{
  "name": "axis",
  "productName": "Axis",
  "version": "0.16.1",
  "private": true,
  "description": "Local-first, provider-agnostic AI engineering and work command center for macOS.",
  "type": "module",
  "main": "desktop/bootstrap.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavolbs/axis.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run app:build",
    "app:build": "vite build --config app/vite.config.ts",
    "dev": "npm run desktop",
    "dev:worker": "tsx src/worker-server.ts",
    "start:worker": "node dist/worker-server.js",
    "desktop": "npm run build && node scripts/run-desktop.mjs",
    "desktop:dir:mac": "npm run build && electron-builder --mac dir --publish never",
    "desktop:pack:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "desktop:release:mac": "node scripts/release-macos.mjs",
    "release:validate": "node scripts/release-metadata.mjs validate",
    "release:version": "node scripts/release-metadata.mjs version",
    "release:notes": "node scripts/release-metadata.mjs notes",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run release:validate && npm run build && npm test",
    "smoke:cloud": "npm run build && node scripts/smoke-cloud-providers.mjs",
    "benchmark": "npm run build && node scripts/benchmark-local.mjs",
    "eval:agent": "npm run build && node scripts/eval-local-agent.mjs",
    "eval:providers": "npm run build && node scripts/eval-multi-provider.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "update-electron-app": "^3.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "44.1.0",
    "electron-builder": "26.15.7",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.1.3"
  }
}
